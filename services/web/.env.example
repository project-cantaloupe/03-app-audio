# 로컬 기본값. 공개 환경에서는 development 모드를 사용하지 않는다.
VITE_AUTH_MODE=development
VITE_DEV_SUBJECT=local-user
VITE_API_BASE_URL=

# 공개 Identity가 준비되지 않은 운영 환경은 disabled를 사용한다.
# Keycloak 연동 시 Audio 전용 Public Realm을 만든 뒤 oidc로 바꾸고 아래 설정을 채운다.
# VITE_OIDC_ISSUER_URL=https://identity.example.com/realms/cantaloupe
# VITE_OIDC_CLIENT_ID=audio-web
# VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
# VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/
# VITE_OIDC_SCOPE=openid profile email
